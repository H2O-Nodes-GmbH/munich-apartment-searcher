# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protect cron + /api/scrape/test (Bearer token or ?secret=)
CRON_SECRET=generate-a-long-random-string
APP_PASSWORD=optional-dashboard-password

# Postmark inbound webhook: https://<app>/api/inbound-email?token=<INBOUND_EMAIL_TOKEN>
INBOUND_EMAIL_TOKEN=generate-a-long-random-string

# Telegram notifications (BotFather → bot token)
# Chat id: your DM, a group id (e.g. -100…), or comma-separated for several destinations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: separate group for the 9pm daily horoscope cron
TELEGRAM_HOROSCOPE_CHAT_ID=

# Browserbase cloud browser for auto-sending Kleinanzeigen messages
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_CONTEXT_ID=

# Extended rental contact form (Kleinanzeigen "Anfrage-Qualität" fields)
KA_CONTACT_SALUTATION=Herr
KA_CONTACT_FIRST_NAME=Max
KA_CONTACT_LAST_NAME=Sherwood
KA_CONTACT_SCHUFA=Vorhanden (< 3 Monate)
KA_CONTACT_EMPLOYMENT=Angestellte(r)
KA_CONTACT_INCOME=4.000€ - 5.000€
KA_CONTACT_HOUSEHOLD=Zweipersonenhaushalt
KA_CONTACT_PETS=Keine
# Optional:
# KA_CONTACT_STREET=
# KA_CONTACT_ZIP=
# KA_CONTACT_CITY=
# KA_CONTACT_PHONE=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protect cron + /api/scrape/test (Bearer token or ?secret=)
CRON_SECRET=generate-a-long-random-string
APP_PASSWORD=optional-dashboard-password

# Telegram notifications (BotFather → bot token)
# Chat id: your DM, a group id (e.g. -100…), or comma-separated for several destinations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
